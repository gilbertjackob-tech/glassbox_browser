{
  "name": "glassbox-browser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main/main.cjs",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "renderer:dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build && esbuild src/main/main.ts src/preload/preload.ts --bundle --platform=node --outdir=dist-electron --format=cjs --out-extension:.js=.cjs --external:electron --external:better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "electron:dev": "node scripts/electron-dev.mjs",
    "gb": "node scripts/glassbox-cli.mjs",
    "test:whatsapp:file": "node scripts/test-whatsapp-send-files-clipboard.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "electron-is-dev": "^3.0.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^14.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "electron": "^41.3.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
